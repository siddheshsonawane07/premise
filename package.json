{
  "name": "premise",
  "version": "0.1.0",
  "private": true,
  "description": "Shared memory for a team's AI coding agents: which rule each piece of code was written under, and what to fix when a rule changes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "premise-hook": "./cli/premise-hook.mjs",
    "premise-fix": "./cli/premise-fix.mjs"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d falkordb",
    "db:down": "docker compose down",
    "docs:queries": "tsx scripts/docs-queries.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "cytoscape": "3.34.3",
    "express": "5.3.0",
    "falkordb": "6.8.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "autocannon": "8.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
